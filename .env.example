# Copy to .env.local and fill in when connecting a live backend.
# Until these are set, the app runs on the typed local data adapter.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key — server-only. Enables admin reads/writes (viewing all
# bookings, status updates) and persisting guest (logged-out) bookings.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for canonical URLs, sitemap, OG). Defaults to localhost in dev.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Admin access — comma-separated allowlist of emails that may reach /admin.
ADMIN_EMAILS=

# Email notifications (optional — Resend). If unset, email is skipped silently.
RESEND_API_KEY=
# Verified sender, e.g. "Azure Horizons <hello@yourdomain.com>"
EMAIL_FROM=
# Where new-booking / contact notifications go (defaults to EMAIL_FROM).
BOOKINGS_NOTIFY_EMAIL=

# WhatsApp contact number in international format, digits only (e.g. 15551234567).
# When set, a WhatsApp button appears in the floating "talk to a designer" CTA.
NEXT_PUBLIC_WHATSAPP_NUMBER=
